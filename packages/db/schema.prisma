// Family Expense Tracker schema (see Family_Expense_Tracker_PRD.docx)
// Money is stored as integer paise (₹1 = 100 paise) so totals never drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  ADMIN
  MEMBER
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
}

enum IncomeType {
  SALARY
  OTHER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// Saved payment methods. UPI is reserved for later; today only CARD and BANK are created.
enum PaymentMethodType {
  CARD
  BANK
  UPI
}

enum CardType {
  CREDIT
  DEBIT
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String
  passwordHash String
  createdAt    DateTime             @default(now())
  memberships  FamilyMember[]
  expenses     Expense[]
  incomes      Income[]
  resets       PasswordReset[]
  savedMethods SavedPaymentMethod[]
}

// A card or bank account that one user has saved. Private to that user.
// Never stores a full card number, CVV or PIN: only the last 4 digits and a nickname.
// A bank account number is stored encrypted (AES-256-GCM); lastFour is kept for masked display.
// Deleting is a soft delete (deletedAt) so old expenses keep their payment method;
// the encrypted number is wiped at that point.
//
// Rules enforced in the database (see the payment_methods migration, Prisma cannot express them):
//  - at most one default per (user, type) among live methods (partial unique index)
//  - CHECK constraints on which columns each type must / must not have
//  - Expense.paymentMethodId must belong to the same user as the expense (composite foreign key)
model SavedPaymentMethod {
  id               String            @id @default(cuid())
  userId           String
  type             PaymentMethodType
  nickname         String?
  cardType         CardType?
  lastFour         String?           @db.VarChar(4)
  accountNumberEnc String?
  isDefault        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id])
  expenses         Expense[]

  @@unique([id, userId])
  @@index([userId, type])
}

// One-time code emailed for "Forgot password". Only a hash of the code is stored.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  attempts  Int       @default(0)
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Family {
  id         String         @id @default(cuid())
  name       String
  createdAt  DateTime       @default(now())
  members    FamilyMember[]
  invites    Invite[]
  categories Category[]
  expenses   Expense[]
  incomes    Income[]
  budgets    Budget[]
}

model FamilyMember {
  id       String   @id @default(cuid())
  userId   String
  familyId String
  role     Role     @default(MEMBER)
  // Removed members are kept (active = false) so their past expenses stay in the family records.
  active   Boolean  @default(true)
  joinedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id])
  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
  @@index([familyId])
}

model Invite {
  id           String       @id @default(cuid())
  familyId     String
  email        String
  // Long secret used by the one-click join link in the email.
  token        String       @unique
  // Short verification code (8 characters) the invited person can type in. Only its hash is stored.
  // Old invites have none. The code works only for the invited email and locks after 5 wrong tries.
  codeHash     String?
  codeAttempts Int          @default(0)
  status       InviteStatus @default(PENDING)
  expiresAt    DateTime
  invitedById  String
  createdAt    DateTime     @default(now())
  family       Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([email, status])
}

model Category {
  id        String    @id @default(cuid())
  // null familyId = one of the 14 ready-made categories shared by every family
  familyId  String?
  name      String
  isDefault Boolean   @default(false)
  family    Family?   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  budgets   Budget[]

  @@index([familyId])
}

model Expense {
  id              String              @id @default(cuid())
  familyId        String
  userId          String
  categoryId      String
  amountPaise     Int
  date            DateTime            @db.Date
  paymentMethod   PaymentMethod
  // Optional link to the saved card / bank account used (only for CARD and BANK_TRANSFER).
  // Old expenses have none. Kept (not nulled) when the saved method is soft-deleted.
  paymentMethodId String?
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  family          Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id])
  category        Category            @relation(fields: [categoryId], references: [id])
  savedMethod     SavedPaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([familyId, date])
  @@index([paymentMethodId])
}

model Income {
  id          String     @id @default(cuid())
  familyId    String
  // userId = the family member who earned it; createdById = who recorded it
  userId      String
  createdById String?
  type        IncomeType
  amountPaise Int
  // "YYYY-MM"
  month       String
  note        String?
  createdAt   DateTime   @default(now())
  family      Family     @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id])

  @@index([familyId, month])
}

model Budget {
  id          String    @id @default(cuid())
  familyId    String
  // "YYYY-MM"
  month       String
  // null categoryId = the total monthly budget
  categoryId  String?
  amountPaise Int
  family      Family    @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])

  @@index([familyId, month])
}
