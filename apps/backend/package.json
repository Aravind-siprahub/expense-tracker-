{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "dotenv -e ../../.env -- node --import tsx --test \"tests/**/*.test.ts\"",
    "clean": "rm -rf dist .turbo 2>/dev/null; exit 0"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/validators": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.9.2"
  }
}
