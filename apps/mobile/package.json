{
  "name": "@repo/mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "rm -rf .expo android ios 2>/dev/null; find . -maxdepth 1 -name '.metro-health-check*' -delete 2>/dev/null; exit 0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "check": "yarn typecheck && yarn lint && yarn test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "7",
    "@react-navigation/native": "7",
    "@react-navigation/native-stack": "7",
    "@repo/api-client": "workspace:*",
    "@repo/types": "workspace:*",
    "@tanstack/react-query": "^5.96.2",
    "expo": "58",
    "expo-clipboard": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "lucide-react-native": "^1.75.0",
    "nativewind": "^4.1.23",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
