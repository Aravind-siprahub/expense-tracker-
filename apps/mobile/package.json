    "@expo/ngrok": "^4.1.3",
    "@react-native/metro-config": "^0.83.0",
    "@repo/tailwind-config": "workspace:*",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "^3.4.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
