{
  "name": "@repo/web-vite",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:app": "tsc --noEmit && vite build --mode app",
    "cap:sync": "yarn build:app && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "cap run android",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "clean": "rm -rf dist .turbo 2>/dev/null; exit 0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@repo/api-client": "workspace:*",
    "@repo/types": "workspace:*",
    "@tanstack/react-query": "^5.96.2",
    "lucide-react": "^1.73.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@repo/tailwind-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20.11.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.9.2",
    "vite": "^7.0.0"
  }
}
