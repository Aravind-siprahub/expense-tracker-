# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (packages/db) and the Express backend.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# ── Backend ────────────────────────────────────────────────────────────────
# Port the Express server listens on. Defaults to 3001 if not set.
PORT=3001

# ── Web (Next.js) ──────────────────────────────────────────────────────────
# API base URL used by @repo/api-client in the Next.js app.
# Defaults to http://localhost:3001 in development.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Mobile (Expo) ──────────────────────────────────────────────────────────
# Only needed when running on a physical device.
# Android emulator uses 10.0.2.2 and iOS simulator uses localhost automatically.
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3001

# Secret used to sign login tokens (generate a long random string)
JWT_SECRET=change-me
# Comma-separated web origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# Email (https://resend.com): leave RESEND_API_KEY empty in development and emails print in the server log
RESEND_API_KEY=
MAIL_FROM=Family Expense Tracker <onboarding@resend.dev>
# Public address of the web app, used in email links
WEB_URL=http://localhost:3000

# ── Email: Gmail SMTP (free, ~500 emails/day) ─────────────────────────────────
# 1. Turn on 2-Step Verification for the Gmail account: https://myaccount.google.com/security
# 2. Create an App Password: https://myaccount.google.com/apppasswords  (16 characters)
# 3. Fill in the two lines below. Do NOT use your normal Gmail password.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  MAIL_FROM="Family Expense Tracker <you@gmail.com>"
# Used for links inside emails. Use the address people actually open (LAN IP or tunnel URL when testing).
WEB_URL=http://localhost:3000

# Set to 1 when the API sits behind a tunnel or reverse proxy (so rate limits see real client IPs)
# TRUST_PROXY=1
