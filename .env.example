# Copy this file to .env in the repository root and fill in the values.
# .env is ignored by git. Never commit real secrets.

# --- Database (PostgreSQL, for example a free Neon project) -------------------
# Connection string the API uses at runtime (on Neon, the "pooled" one).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Direct connection string Prisma uses to create and change tables
# (on Neon, the one without "-pooler" in the host). For a local database use the same value.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# --- API ----------------------------------------------------------------------
# Port the API listens on (default 3001).
PORT=3001
# Secret that signs login tokens. Use a long random value, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me
# Extra web addresses allowed to call the API, comma separated (localhost:3000 is always allowed).
CORS_ORIGINS=
# Set to 1 when the API sits behind a tunnel or reverse proxy, so rate limits see real client IPs.
# TRUST_PROXY=1

# --- Web app ------------------------------------------------------------------
# Public address of the web app. Used for links inside emails, so use an address
# the recipient can open (a tunnel or your live site), not localhost, when inviting others.
WEB_URL=http://localhost:5173
# In development the web app finds the API on its own (same host, port 3001). To point it elsewhere,
# create apps/web-vite/.env.local containing:  VITE_API_URL=https://your-api.example.com

# --- Mobile app (Expo) --------------------------------------------------------
# Only needed on a real phone. Put this in apps/mobile/.env.local (not here):
#   EXPO_PUBLIC_API_URL=http://192.168.1.5:3001
# The Android emulator (10.0.2.2) and iOS simulator (localhost) work without it.

# --- Email: Gmail SMTP (free, about 500 emails a day) -------------------------
# 1. Turn on 2-Step Verification: https://myaccount.google.com/security
# 2. Create an App Password:      https://myaccount.google.com/apppasswords
# 3. Fill in the two lines below. Do NOT use your normal Gmail password.
SMTP_USER=
SMTP_PASS=
# Optional: another SMTP service, or a custom sender.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# MAIL_FROM="Family Expense Tracker <you@gmail.com>"

# --- Email: Resend (alternative to SMTP, https://resend.com) -------------------
# Used only when SMTP_USER and SMTP_PASS are empty.
# RESEND_API_KEY=

# With no email provider configured, emails are printed in the API log instead.

# --- Saved bank accounts ------------------------------------------------------
# Key that encrypts saved bank account numbers (AES-256-GCM): 32 random bytes, base64. Create one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and back it up: if it is lost, stored account numbers cannot be read again.
# Changing it makes existing saved accounts unreadable (cards are not affected).
PAYMENT_ENCRYPTION_KEY=
