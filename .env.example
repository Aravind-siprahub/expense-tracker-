# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma (packages/db) and the Express backend.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# ── Backend ────────────────────────────────────────────────────────────────
# Port the Express server listens on. Defaults to 3001 if not set.
PORT=3001

# ── Web (Next.js) ──────────────────────────────────────────────────────────
# API base URL used by @repo/api-client in the Next.js app.
# Defaults to http://localhost:3001 in development.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── Mobile (Expo) ──────────────────────────────────────────────────────────
# Only needed when running on a physical device.
# Android emulator uses 10.0.2.2 and iOS simulator uses localhost automatically.
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3001
